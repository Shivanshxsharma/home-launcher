<?xml version="1.0" encoding="utf-8"?>
<!-- Face of an Up next card: the episode still, a badge, and episode progress. Words go below. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:layout_height="117dp"
    tools:layout_width="208dp"
    tools:parentTag="android.widget.FrameLayout">

    <ImageView
        android:id="@+id/card_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/card_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/badge_cream"
        android:fontFamily="@font/geist_bold"
        android:includeFontPadding="false"
        android:letterSpacing="0.12"
        android:paddingStart="5dp"
        android:paddingTop="3dp"
        android:paddingEnd="5dp"
        android:paddingBottom="3dp"
        android:textColor="@color/ink_dark"
        android:textSize="7.5dp" />

    <com.shivansh.mibox.ui.Segments
        android:id="@+id/card_segments"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="9dp" />
</merge>
