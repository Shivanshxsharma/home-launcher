<?xml version="1.0" encoding="utf-8"?>
<!--
  Built on the 1920x1080 mockup: 1dp here = 2 mockup px (the box runs at 960x540dp).
  Bottom to top: the preview video (a SurfaceView, composited by the hardware under the window),
  the backdrop art that fades away to reveal it, static scrims, a dim veil, the scrolling
  content, the top chrome and the preview chip.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    tools:background="@color/night">

    <SurfaceView
        android:id="@+id/preview_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:forceHasOverlappingRendering="false">

        <com.shivansh.mibox.ui.BackdropSlot
            android:id="@+id/slot_lower"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />

        <com.shivansh.mibox.ui.BackdropSlot
            android:id="@+id/slot_upper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />
    </FrameLayout>

    <View
        android:id="@+id/scrim_left"
        android:layout_width="576dp"
        android:layout_height="match_parent"
        android:forceHasOverlappingRendering="false" />

    <View
        android:id="@+id/scrim_bottom"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="bottom"
        android:forceHasOverlappingRendering="false" />

    <View
        android:id="@+id/scrim_top"
        android:layout_width="match_parent"
        android:layout_height="97dp"
        android:forceHasOverlappingRendering="false" />

    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/night"
        android:forceHasOverlappingRendering="false"
        android:visibility="invisible" />

    <!-- Everything below the chrome; springs up by translationY as you go down the rows. -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="1800dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:forceHasOverlappingRendering="false">

        <include layout="@layout/home_hero" />

        <include layout="@layout/home_shelf" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/row_apps"
            style="@style/Row"
            android:layout_height="122dp"
            android:layout_marginTop="390dp" />

        <!--
          The show rows, one section each: the user's (My Shows, Favorites) and the suggestions.
          A section with no cards is gone and the rest close up; HomeActivity scrolls to each
          section wherever it ends up.
        -->
        <LinearLayout
            android:id="@+id/sections"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="545dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:forceHasOverlappingRendering="false"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/section_up_next"
                style="@style/Section"
                android:layout_height="186dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/row_up_next"
                    style="@style/Row"
                    android:layout_height="157dp"
                    android:layout_marginTop="29dp" />

                <!-- After the row, so a lifted card's shadow passes under the title. -->
                <LinearLayout style="@style/RowHeader">

                    <TextView
                        android:id="@+id/title_up_next"
                        style="@style/RowTitle" />

                    <TextView
                        android:id="@+id/sub_up_next"
                        style="@style/RowSubtitle" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/section_my_shows"
                style="@style/Section"
                android:layout_height="229dp"
                android:layout_marginTop="28dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/row_my_shows"
                    style="@style/Row"
                    android:layout_height="196dp"
                    android:layout_marginTop="33dp" />

                <!-- After the row, so a lifted card's shadow passes under the title. -->
                <LinearLayout style="@style/RowHeader">

                    <TextView
                        android:id="@+id/title_my_shows"
                        style="@style/RowTitle" />

                    <TextView
                        android:id="@+id/sub_my_shows"
                        style="@style/RowSubtitle" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/section_favorites"
                style="@style/Section"
                android:layout_height="208dp"
                android:layout_marginTop="28dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/row_favorites"
                    style="@style/Row"
                    android:layout_height="179dp"
                    android:layout_marginTop="29dp" />

                <!-- After the row, so a lifted card's shadow passes under the title. -->
                <LinearLayout style="@style/RowHeader">

                    <TextView
                        android:id="@+id/title_favorites"
                        style="@style/RowTitle" />

                    <TextView
                        android:id="@+id/sub_favorites"
                        style="@style/RowSubtitle" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/section_popular"
                style="@style/Section"
                android:layout_height="229dp"
                android:layout_marginTop="28dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/row_popular"
                    style="@style/Row"
                    android:layout_height="196dp"
                    android:layout_marginTop="33dp" />

                <!-- After the row, so a lifted card's shadow passes under the title. -->
                <LinearLayout style="@style/RowHeader">

                    <TextView
                        android:id="@+id/title_popular"
                        style="@style/RowTitle" />

                    <TextView
                        android:id="@+id/sub_popular"
                        style="@style/RowSubtitle" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/section_acclaimed"
                style="@style/Section"
                android:layout_height="208dp"
                android:layout_marginTop="28dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/row_acclaimed"
                    style="@style/Row"
                    android:layout_height="179dp"
                    android:layout_marginTop="29dp" />

                <!-- After the row, so a lifted card's shadow passes under the title. -->
                <LinearLayout style="@style/RowHeader">

                    <TextView
                        android:id="@+id/title_acclaimed"
                        style="@style/RowTitle" />

                    <TextView
                        android:id="@+id/sub_acclaimed"
                        style="@style/RowSubtitle" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- The other tabs' pages, shown in place of the home content. -->
    <include layout="@layout/page_apps" />

    <include layout="@layout/page_search" />

    <include layout="@layout/page_media" />

    <include layout="@layout/page_signin" />

    <include layout="@layout/home_chrome" />

    <LinearLayout
        android:id="@+id/preview_chip"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_gravity="end"
        android:layout_marginTop="350dp"
        android:layout_marginEnd="56dp"
        android:alpha="0"
        android:forceHasOverlappingRendering="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingEnd="11dp"
        android:visibility="invisible">

        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_muted" />

        <TextView
            android:id="@+id/preview_chip_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/geist_medium"
            android:includeFontPadding="false"
            android:text="@string/preview_muted"
            android:textColor="@color/text_soft"
            android:textSize="9.5dp" />
    </LinearLayout>

    <!-- A short confirmation, e.g. "Added to My Shows". -->
    <TextView
        android:id="@+id/note"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:alpha="0"
        android:fontFamily="@font/geist_medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/ink"
        android:textSize="11.5dp"
        android:visibility="invisible" />

    <include layout="@layout/menu" />
</FrameLayout>
