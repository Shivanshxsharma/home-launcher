<?xml version="1.0" encoding="utf-8"?>
<!-- A page whose content comes with TMDB in phase 2: one glyph, a title and a line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_soon"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="56dp"
    android:layout_marginTop="190dp"
    android:alpha="0"
    android:forceHasOverlappingRendering="false"
    android:orientation="vertical"
    android:visibility="invisible">

    <FrameLayout
        android:id="@+id/page_soon_badge"
        android:layout_width="60dp"
        android:layout_height="60dp">

        <ImageView
            android:id="@+id/page_soon_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/page_soon_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/geist_semibold"
        android:includeFontPadding="false"
        android:letterSpacing="-0.03"
        android:textColor="@color/ink"
        android:textSize="36dp" />

    <TextView
        android:id="@+id/page_soon_line"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/geist_regular"
        android:lineHeight="18dp"
        android:textColor="@color/text_label"
        android:textSize="12.5dp" />
</LinearLayout>
