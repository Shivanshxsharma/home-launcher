<?xml version="1.0" encoding="utf-8"?>
<!--
  The hero: tag, the show's title (its logo art when TMDB has one), then the details that step
  away in ambient mode. Play, Add to List and Trailer are focusable; left and right move between them.
  Anchored at the bottom, just above the apps row, so a tall logo or a two-line title grows upward.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hero"
    android:layout_width="450dp"
    android:layout_height="374dp"
    android:layout_marginStart="56dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:forceHasOverlappingRendering="false"
    android:gravity="bottom"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/hero_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:forceHasOverlappingRendering="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/hero_dot"
            android:layout_width="5dp"
            android:layout_height="5dp"
            android:background="@drawable/dot" />

        <TextView
            android:id="@+id/hero_provider"
            style="@style/TagText"
            android:layout_marginStart="7dp"
            android:fontFamily="@font/geist_semibold"
            android:textColor="@color/ink" />

        <TextView
            style="@style/TagText"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/geist_medium"
            android:text="·"
            android:textColor="@color/separator" />

        <TextView
            android:id="@+id/hero_status"
            style="@style/TagText"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/geist_medium"
            android:textColor="@color/text_label" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/hero_title_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:transformPivotX="0dp"
        android:transformPivotY="0dp">

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/ink" />

        <!-- The show's own title art from TMDB, when it has one; sized in code to fit its box. -->
        <ImageView
            android:id="@+id/hero_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/hero_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:forceHasOverlappingRendering="false"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/hero_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:forceHasOverlappingRendering="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hero_next"
                style="@style/MetaText"
                android:fontFamily="@font/geist_semibold"
                android:textColor="@color/ink" />

            <TextView style="@style/MetaText.Separator" />

            <TextView
                android:id="@+id/hero_genre"
                style="@style/MetaText" />

            <TextView style="@style/MetaText.Separator" />

            <TextView
                android:id="@+id/hero_year"
                style="@style/MetaText" />

            <TextView
                android:id="@+id/hero_rating"
                style="@style/MetaText"
                android:layout_marginStart="7dp"
                android:background="@drawable/rating_outline"
                android:fontFamily="@font/geist_semibold"
                android:paddingStart="4.5dp"
                android:paddingTop="1.5dp"
                android:paddingEnd="4.5dp"
                android:paddingBottom="1.5dp"
                android:textColor="@color/ink"
                android:textSize="8dp" />

            <TextView
                android:id="@+id/hero_score_gap"
                style="@style/MetaText.Separator" />

            <!-- TMDB's user score, "★ 8.4"; gone with its separator when there isn't one. -->
            <TextView
                android:id="@+id/hero_score"
                style="@style/MetaText"
                android:fontFamily="@font/geist_semibold"
                android:textColor="@color/ink" />
        </LinearLayout>

        <TextView
            android:id="@+id/hero_blurb"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:fontFamily="@font/geist_regular"
            android:lineHeight="18dp"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowRadius="12"
            android:textColor="@color/text_soft"
            android:textSize="12.5dp" />

        <LinearLayout
            android:id="@+id/hero_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:forceHasOverlappingRendering="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/hero_play_wrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/hero_play_glow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY" />

                <LinearLayout
                    android:id="@+id/hero_play"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/pill_cream"
                    android:focusable="true"
                    android:focusedByDefault="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:id="@+id/hero_play_icon"
                        android:layout_width="10dp"
                        android:layout_height="11dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_play" />

                    <TextView
                        android:id="@+id/hero_play_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:fontFamily="@font/geist_semibold"
                        android:includeFontPadding="false"
                        android:textColor="@color/ink_dark"
                        android:textSize="12.5dp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/hero_list"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="17dp">

                <ImageView
                    android:id="@+id/hero_list_icon"
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_plus" />

                <TextView
                    android:id="@+id/hero_list_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="@font/geist_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/add_to_list"
                    android:textColor="@color/ink"
                    android:textSize="12.5dp" />
            </LinearLayout>

            <!-- Plays the trailer in the YouTube app; Back returns here. -->
            <LinearLayout
                android:id="@+id/hero_trailer"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="17dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/hero_trailer_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_film" />

                <TextView
                    android:id="@+id/hero_trailer_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="@font/geist_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/trailer"
                    android:textColor="@color/ink"
                    android:textSize="12.5dp" />
            </LinearLayout>
        </LinearLayout>

        <com.shivansh.mibox.ui.HeroDots
            android:id="@+id/hero_dots"
            android:layout_width="68dp"
            android:layout_height="3dp"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</LinearLayout>
