<?xml version="1.0" encoding="utf-8"?>
<!-- The profile circle, with a white ring when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:drawable="@drawable/profile_circle" />
            <item>
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="@color/ink" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@drawable/profile_circle" />
</selector>
