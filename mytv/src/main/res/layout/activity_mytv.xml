<?xml version="1.0" encoding="utf-8"?>
<!--
  MY TV, laid out at 960x540dp (1920x1080 px on the Mi Box). A floating bar of tabs with network and
  settings at the right, and Home's two racks, one showing at a time: favorites over the focused
  title's backdrop, then apps under the clock. No glass: solid surfaces, with shading baked into the pictures.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <FrameLayout
        android:id="@+id/scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/wall_lower"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/wall_upper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- ===== The clock ===== -->

    <LinearLayout
        android:id="@+id/clock_group"
        android:forceHasOverlappingRendering="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="86dp"
        android:alpha="0"
        android:orientation="vertical"
        android:visibility="invisible">

        <TextView
            android:id="@+id/date"
            style="@style/Heading"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:textSize="16dp" />

        <com.shivansh.mytv.ui.ClockFace
            android:id="@+id/clock"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <!-- ===== The focused title ===== -->

    <LinearLayout
        android:id="@+id/hero"
        android:forceHasOverlappingRendering="false"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="186dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hero_kicker"
            style="@style/Note"
            android:fontFamily="@font/geist_medium"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/geist_bold"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.96"
            android:maxLines="2"
            android:textColor="@color/ink"
            android:textSize="46dp" />

        <TextView
            android:id="@+id/hero_meta"
            style="@style/Note"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/geist_medium"
            android:textColor="@color/ink"
            android:textSize="13dp" />

        <TextView
            android:id="@+id/hero_overview"
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="@font/geist_regular"
            android:includeFontPadding="false"
            android:lineSpacingExtra="4dp"
            android:maxLines="3"
            android:textColor="@color/ink"
            android:textSize="12.5dp" />
    </LinearLayout>

    <!-- TMDB set-up: the QR code on white, at the right. -->
    <LinearLayout
        android:id="@+id/qr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="96dp"
        android:orientation="vertical"
        android:visibility="invisible">

        <FrameLayout
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:background="@color/ink"
            android:padding="22dp">

            <ImageView
                android:id="@+id/qr_code"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/qr_label"
            style="@style/Note"
            android:layout_width="176dp"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:singleLine="false"
            android:textColor="@color/ink" />
    </LinearLayout>

    <!-- ===== Home's racks ===== -->

    <FrameLayout
        android:id="@+id/rack_favs"
        android:forceHasOverlappingRendering="false"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:layout_gravity="bottom" />

    <FrameLayout
        android:id="@+id/rack_apps"
        android:forceHasOverlappingRendering="false"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="20dp"
        android:alpha="0"
        android:visibility="invisible">

        <TextView
            android:id="@+id/rack_apps_label"
            style="@style/Heading"
            android:layout_marginStart="48dp"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:textSize="14dp" />

        <FrameLayout
            android:id="@+id/rack_apps_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp" />
    </FrameLayout>

    <!-- ===== Favorites: every saved film and show ===== -->

    <FrameLayout
        android:id="@+id/page_favs"
        android:forceHasOverlappingRendering="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/surface"
        android:visibility="invisible">

        <TextView
            style="@style/Heading"
            android:layout_marginStart="48dp"
            android:layout_marginTop="80dp"
            android:text="@string/favs_title"
            android:textSize="20dp" />

        <TextView
            style="@style/Note"
            android:layout_marginStart="48dp"
            android:layout_marginTop="108dp"
            android:text="@string/favs_hint" />

        <FrameLayout
            android:id="@+id/favs_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="122dp" />
    </FrameLayout>

    <!-- ===== Search: films and shows ===== -->

    <FrameLayout
        android:id="@+id/page_search"
        android:forceHasOverlappingRendering="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/surface"
        android:visibility="invisible">

        <TextView
            android:id="@+id/search_query"
            style="@style/Heading"
            android:layout_marginStart="48dp"
            android:layout_marginTop="80dp"
            android:alpha="0.55"
            android:text="@string/search_placeholder"
            android:textSize="20dp" />

        <com.shivansh.mytv.ui.Keys
            android:id="@+id/keys"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="124dp" />

        <FrameLayout
            android:id="@+id/search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="280dp"
            android:layout_marginTop="112dp" />

        <TextView
            android:id="@+id/search_none"
            style="@style/Note"
            android:layout_marginStart="300dp"
            android:layout_marginTop="130dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ===== Style: over the wallpaper, so a change shows at once ===== -->

    <FrameLayout
        android:id="@+id/page_style"
        android:forceHasOverlappingRendering="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="invisible">

        <TextView
            style="@style/Heading"
            android:layout_marginStart="48dp"
            android:layout_marginTop="322dp"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:text="@string/style_wallpaper"
            android:textSize="13dp" />

        <FrameLayout
            android:id="@+id/style_walls"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="334dp" />

        <TextView
            style="@style/Heading"
            android:layout_marginStart="48dp"
            android:layout_marginTop="432dp"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:text="@string/style_clock"
            android:textSize="13dp" />

        <FrameLayout
            android:id="@+id/style_faces"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="444dp" />
    </FrameLayout>

    <!-- ===== The floating bar ===== -->

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="22dp"
        android:background="@drawable/bar_bg">

        <com.shivansh.mytv.ui.Pill
            android:id="@+id/bar_pill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="4dp" />

        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="4dp"
            android:orientation="horizontal">

            <TextView
                style="@style/Tab"
                android:text="@string/tab_home" />

            <TextView
                style="@style/Tab"
                android:text="@string/tab_favorites" />

            <TextView
                style="@style/Tab"
                android:text="@string/tab_search" />

            <TextView
                style="@style/Tab"
                android:text="@string/tab_style" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Time, network and settings, top right ===== -->

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:fontFamily="@font/geist_medium"
            android:fontFeatureSettings="tnum"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:textColor="@color/ink"
            android:textSize="14dp" />

        <LinearLayout
            android:id="@+id/corner_network"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/corner_bg"
            android:contentDescription="@string/corner_network"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="13dp">

            <ImageView
                android:id="@+id/corner_network_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wifi"
                android:tint="@color/corner_fg" />

            <TextView
                android:id="@+id/corner_network_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/geist_medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/corner_fg"
                android:textSize="12dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/corner_settings"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/corner_bg"
            android:contentDescription="@string/corner_settings">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_gear"
                android:tint="@color/corner_fg" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/note"
        style="@style/Note"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:alpha="0"
        android:background="@drawable/note_bg"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:textColor="@color/ink"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="invisible" />
</FrameLayout>
