<?xml version="1.0" encoding="utf-8"?>
<!--
  MY TV, laid out at 960x540dp (1920x1080 px on the Mi Box). A full-screen wallpaper with a large
  clock and a small row of favorites; Favorites and Search are plain solid pages, and Style sits
  over the wallpaper so changes show live. No glass: solid surfaces and one simple scrim.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- ===== Wallpaper, scrim and clock ===== -->

    <FrameLayout
        android:id="@+id/scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/wall_lower"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/wall_upper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="invisible" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim" />

        <TextView
            android:id="@+id/date"
            style="@style/Heading"
            android:layout_marginStart="48dp"
            android:layout_marginTop="78dp"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:textSize="16dp" />

        <!-- Four faces, one showing. Stacked: the hour over the minutes. -->
        <LinearLayout
            android:id="@+id/face_stacked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp"
            android:layout_marginTop="100dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/stacked_hours"
                style="@style/Digits"
                android:fontFamily="@font/geist_bold"
                android:textSize="104dp" />

            <TextView
                android:id="@+id/stacked_minutes"
                style="@style/Digits"
                android:layout_marginTop="-40dp"
                android:fontFamily="@font/geist_regular"
                android:textSize="104dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/face_wide"
            style="@style/Digits"
            android:layout_marginStart="44dp"
            android:layout_marginTop="104dp"
            android:fontFamily="@font/geist_regular"
            android:letterSpacing="0.04"
            android:textSize="150dp"
            android:visibility="gone" />

        <com.shivansh.mytv.ui.Dial
            android:id="@+id/face_dial"
            android:layout_width="206dp"
            android:layout_height="206dp"
            android:layout_marginStart="48dp"
            android:layout_marginTop="108dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/face_serif"
            style="@style/Digits"
            android:layout_marginStart="44dp"
            android:layout_marginTop="96dp"
            android:fontFamily="@font/instrument_serif"
            android:textSize="190dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ===== Home: a small row of favorites ===== -->

    <FrameLayout
        android:id="@+id/home_row"
        android:layout_width="match_parent"
        android:layout_height="126dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="28dp" />

    <TextView
        android:id="@+id/home_empty"
        style="@style/Note"
        android:layout_gravity="bottom"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="48dp"
        android:text="@string/home_empty"
        android:textColor="@color/ink"
        android:visibility="gone" />

    <!-- ===== Favorites: every app, yours first ===== -->

    <FrameLayout
        android:id="@+id/page_favs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/surface"
        android:visibility="invisible">

        <TextView
            style="@style/Heading"
            android:layout_marginStart="48dp"
            android:layout_marginTop="76dp"
            android:text="@string/favs_title"
            android:textSize="20dp" />

        <TextView
            android:id="@+id/favs_hint"
            style="@style/Note"
            android:layout_marginStart="48dp"
            android:layout_marginTop="104dp"
            android:text="@string/favs_hint" />

        <FrameLayout
            android:id="@+id/favs_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="120dp" />
    </FrameLayout>

    <!-- ===== Search ===== -->

    <FrameLayout
        android:id="@+id/page_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/surface"
        android:visibility="invisible">

        <TextView
            android:id="@+id/search_query"
            style="@style/Heading"
            android:layout_marginStart="48dp"
            android:layout_marginTop="76dp"
            android:textSize="20dp" />

        <com.shivansh.mytv.ui.Keys
            android:id="@+id/keys"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="120dp" />

        <FrameLayout
            android:id="@+id/search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="280dp"
            android:layout_marginTop="108dp" />

        <TextView
            android:id="@+id/search_none"
            style="@style/Note"
            android:layout_marginStart="300dp"
            android:layout_marginTop="124dp"
            android:text="@string/search_none"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ===== Style: over the wallpaper, so a change shows at once ===== -->

    <FrameLayout
        android:id="@+id/page_style"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="invisible">

        <TextView
            style="@style/Heading"
            android:layout_marginStart="48dp"
            android:layout_marginTop="322dp"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:text="@string/style_wallpaper"
            android:textSize="13dp" />

        <FrameLayout
            android:id="@+id/style_walls"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="334dp" />

        <TextView
            style="@style/Heading"
            android:layout_marginStart="48dp"
            android:layout_marginTop="432dp"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:text="@string/style_clock"
            android:textSize="13dp" />

        <FrameLayout
            android:id="@+id/style_faces"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="444dp" />
    </FrameLayout>

    <!-- ===== Tabs ===== -->

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            style="@style/Tab"
            android:text="@string/tab_home" />

        <TextView
            style="@style/Tab"
            android:text="@string/tab_favorites" />

        <TextView
            style="@style/Tab"
            android:text="@string/tab_search" />

        <TextView
            style="@style/Tab"
            android:text="@string/tab_style" />
    </LinearLayout>

    <!-- ===== Options for an app ===== -->

    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="invisible" />
</FrameLayout>
