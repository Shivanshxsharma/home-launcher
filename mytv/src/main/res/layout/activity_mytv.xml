<?xml version="1.0" encoding="utf-8"?>
<!--
  MY TV, laid out at 960x540dp (1920x1080 px on the Mi Box). A floating bar of tabs with network and
  settings at the right, and Home's two racks, one showing at a time: favorites over the focused
  title's backdrop, then apps in a glass dock under the clock. Glass is frost, not live blur (see Frost).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <FrameLayout
        android:id="@+id/scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/wall_lower"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/wall_upper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- ===== The clock ===== -->

    <FrameLayout
        android:id="@+id/clock_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="48dp"
        android:alpha="0"
        android:forceHasOverlappingRendering="false"
        android:visibility="invisible">

        <com.shivansh.mytv.ui.ClockFace
            android:id="@+id/clock"
            android:layout_width="match_parent"
            android:layout_height="240dp" />
    </FrameLayout>

    <!-- The scenery's foreground, in front of the Glass clock. -->
    <FrameLayout
        android:id="@+id/depth_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:forceHasOverlappingRendering="false"
        android:visibility="invisible">

        <ImageView
            android:id="@+id/depth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitStart" />
    </FrameLayout>

    <!-- ===== The focused title ===== -->

    <FrameLayout
        android:id="@+id/hero"
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="176dp"
        android:forceHasOverlappingRendering="false">

        <LinearLayout
            android:id="@+id/hero_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:forceHasOverlappingRendering="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hero_kicker"
                style="@style/Note"
                android:fontFamily="@font/geist_medium"
                android:textColor="@color/ink" />

            <ImageView
                android:id="@+id/hero_logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:maxHeight="96dp"
                android:maxWidth="320dp"
                android:scaleType="fitStart"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/geist_semibold"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="0.96"
                android:maxLines="2"
                android:textColor="@color/ink"
                android:textSize="46dp" />

            <TextView
                android:id="@+id/hero_meta"
                style="@style/Note"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/geist_medium"
                android:textColor="@color/ink"
                android:textSize="13dp" />

            <TextView
                android:id="@+id/hero_overview"
                android:layout_width="440dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:alpha="0.86"
                android:ellipsize="end"
                android:fontFamily="@font/geist_regular"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:maxLines="3"
                android:textColor="@color/ink"
                android:textSize="12.5dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- TMDB set-up: the QR code on white, at the right. -->
    <LinearLayout
        android:id="@+id/qr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="96dp"
        android:orientation="vertical"
        android:visibility="invisible">

        <FrameLayout
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:background="@color/ink"
            android:padding="22dp">

            <ImageView
                android:id="@+id/qr_code"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/qr_label"
            style="@style/Note"
            android:layout_width="176dp"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:singleLine="false"
            android:textColor="@color/ink" />
    </LinearLayout>

    <!-- ===== Home's racks ===== -->

    <FrameLayout
        android:id="@+id/rack_favs"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:layout_gravity="bottom"
        android:forceHasOverlappingRendering="false" />

    <!-- The rest of the apps, revealed below the first row. -->
    <FrameLayout
        android:id="@+id/all_sheet"
        android:layout_width="match_parent"
        android:layout_height="326dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="14dp"
        android:alpha="0"
        android:clipChildren="false"
        android:forceHasOverlappingRendering="false"
        android:visibility="invisible">

        <TextView
            style="@style/Heading"
            android:layout_marginStart="18dp"
            android:layout_marginTop="16dp"
            android:text="@string/all_apps"
            android:textSize="13dp" />

        <FrameLayout
            android:id="@+id/all_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="34dp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/rack_apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:forceHasOverlappingRendering="false"
        android:visibility="invisible">

        <FrameLayout
            android:id="@+id/apps_lift"
            android:layout_width="match_parent"
            android:layout_height="136dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/rack_apps_label"
                style="@style/Heading"
                android:layout_marginStart="48dp"
                android:shadowColor="#66000000"
                android:shadowRadius="6"
                android:textSize="13dp" />

            <TextView
                android:id="@+id/rack_apps_hint"
                style="@style/Heading"
                android:layout_gravity="end"
                android:layout_marginEnd="48dp"
                android:alpha="0.8"
                android:fontFamily="@font/geist_medium"
                android:shadowColor="#66000000"
                android:shadowRadius="6"
                android:text="@string/all_hint"
                android:textSize="12dp" />

            <FrameLayout
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp" />
        </FrameLayout>
    </FrameLayout>

    <!-- Frost behind Favorites and Search. -->
    <View
        android:id="@+id/page_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="invisible" />

    <!-- ===== Search: films and shows ===== -->

    <FrameLayout
        android:id="@+id/page_search"
        android:forceHasOverlappingRendering="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:visibility="invisible">

        <TextView
            android:id="@+id/search_query"
            style="@style/Heading"
            android:layout_marginStart="48dp"
            android:layout_marginTop="80dp"
            android:alpha="0.55"
            android:text="@string/search_placeholder"
            android:textSize="20dp" />

        <com.shivansh.mytv.ui.Keys
            android:id="@+id/keys"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="124dp" />

        <FrameLayout
            android:id="@+id/search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="280dp"
            android:layout_marginTop="112dp" />

        <TextView
            android:id="@+id/search_none"
            style="@style/Note"
            android:layout_marginStart="300dp"
            android:layout_marginTop="130dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ===== Style: a glass sheet over the wallpaper, so a change shows at once ===== -->

    <FrameLayout
        android:id="@+id/page_style"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:forceHasOverlappingRendering="false"
        android:visibility="invisible">

        <FrameLayout
            android:id="@+id/style_sheet"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="14dp">

            <TextView
                style="@style/Heading"
                android:layout_marginStart="18dp"
                android:layout_marginTop="14dp"
                android:text="@string/style_wallpaper"
                android:textSize="12dp" />

            <FrameLayout
                android:id="@+id/style_walls"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="26dp" />

            <TextView
                style="@style/Heading"
                android:layout_marginStart="18dp"
                android:layout_marginTop="112dp"
                android:text="@string/style_clock"
                android:textSize="12dp" />

            <FrameLayout
                android:id="@+id/style_faces"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="124dp" />
        </FrameLayout>

        <!-- The QR code for the phone page, over the clock. -->
        <LinearLayout
            android:id="@+id/phone_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="70dp"
            android:layout_marginEnd="30dp"
            android:alpha="0"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp"
            android:visibility="invisible">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/ink"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/phone_code"
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="210dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Heading"
                    android:layout_width="match_parent"
                    android:singleLine="false"
                    android:text="@string/phone_title"
                    android:textSize="17dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/geist_regular"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/phone_line"
                    android:textColor="@color/ink"
                    android:textSize="11.5dp" />

                <TextView
                    android:id="@+id/phone_link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:alpha="0.7"
                    android:fontFamily="@font/geist_medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/ink"
                    android:textSize="11dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ===== The floating bar ===== -->

    <FrameLayout
        android:id="@+id/bar_frame"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="25dp">

        <com.shivansh.mytv.ui.Pill
            android:id="@+id/bar_pill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="3dp" />

        <LinearLayout
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:orientation="horizontal">

            <TextView
                style="@style/Tab"
                android:text="@string/tab_home" />

            <TextView
                style="@style/Tab"
                android:text="@string/tab_favorites" />

            <TextView
                style="@style/Tab"
                android:text="@string/tab_search" />

            <TextView
                style="@style/Tab"
                android:text="@string/tab_style" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Time, network and settings, top right ===== -->

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:fontFamily="@font/geist_medium"
            android:fontFeatureSettings="tnum"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:textColor="@color/ink"
            android:textSize="14dp" />

        <LinearLayout
            android:id="@+id/corner_network"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:contentDescription="@string/corner_network"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="13dp">

            <ImageView
                android:id="@+id/corner_network_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wifi"
                android:tint="@color/corner_fg" />

            <TextView
                android:id="@+id/corner_network_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/geist_medium"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textColor="@color/corner_fg"
                android:textSize="12dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/corner_settings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/corner_settings">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_gear"
                android:tint="@color/corner_fg" />
        </FrameLayout>
    </LinearLayout>

    <!-- ===== The app switcher: only the remote's Apps button opens it ===== -->

    <FrameLayout
        android:id="@+id/switcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:forceHasOverlappingRendering="false"
        android:visibility="invisible">

        <TextView
            android:id="@+id/switcher_title"
            style="@style/Heading"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="66dp"
            android:shadowColor="#66000000"
            android:shadowRadius="8"
            android:textSize="21dp" />

        <com.shivansh.mytv.ui.CardStack
            android:id="@+id/switcher_stack"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/switcher_empty"
            style="@style/Heading"
            android:layout_gravity="center"
            android:text="@string/recent_empty"
            android:textSize="18dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/switcher_hint"
            style="@style/Note"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="84dp"
            android:text="@string/recent_hint"
            android:textColor="@color/ink"
            android:textSize="12.5dp" />

        <TextView
            android:id="@+id/switcher_clear"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="32dp"
            android:fontFamily="@font/geist_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/recent_clear"
            android:textColor="@color/ink"
            android:textSize="13dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/note"
        style="@style/Note"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:alpha="0"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp"
        android:textColor="@color/ink"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/menu"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="invisible" />
</FrameLayout>
